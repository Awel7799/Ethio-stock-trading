NODE_ENV=production
PORT=10000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/ethio_stock_trading?retryWrites=true&w=majority
JWT_SECRET=generate-a-long-random-secret
JWT_REFRESH_SECRET=generate-another-long-random-secret
